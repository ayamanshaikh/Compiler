# ==============================================================================
# CodeVista AI - Environment Variables Template
# Copy this file to .env or configure in your deployment environment.
# NEVER commit real credentials or secrets to version control.
# ==============================================================================

# Backend Server Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=default

# PostgreSQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/codevista
DB_HOST=localhost
DB_PORT=5432
DB_NAME=codevista
DB_USER=codevista
DB_PASSWORD=codevista_secure_password

# CORS Configuration (comma-separated allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8080/api
