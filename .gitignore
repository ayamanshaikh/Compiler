# Root gitignore for CodeVista AI Monorepo

# Environment variables
.env
.env.local
.env.*.local

# Backend / Maven
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
*.class
*.jar
*.war

# Frontend / Node
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/coverage/

# IDE & OS
*.tsbuildinfo
.idea/
*.iml
.vscode/
*.swp
*.DS_Store
Thumbs.db
